rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    match /appStates/{stateId} {
      // Allow any user to read/write for now since this 
      // replaces localStorage and has its own custom auth in the json payload.
      // Since they haven't adopted Firebase Auth yet, allow true.
      allow read, write: if true;
    }
  }
}
